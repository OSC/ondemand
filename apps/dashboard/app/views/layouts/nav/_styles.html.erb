<style nonce="<%= content_security_policy_nonce %>">
.navbar-dark {
  background-color: <%= bg_color || 'rgb(83, 86, 90)' %>;
}

.navbar-light {
  background-color: <%= bg_color || 'rgb(248, 248, 248)' %>;
}

/* always round so the corners don't flicker while the background color transitions in */
.navbar .navbar-nav .nav-link {
  border-radius: 0.25em;
}

.navbar-dark .navbar-nav .nav-link:focus-visible, .navbar-dark .navbar-nav .nav-link.dropdown-toggle.show {
  background-color: <%= link_active_color || 'rgb(59, 61, 63)' %>;
}
.navbar-light .navbar-nav .nav-link:focus-visible, .navbar-light .navbar-nav .nav-link.dropdown-toggle.show {
  background-color: <%= link_active_color || 'rgb(231, 231, 231)' %>;
}
</style>
