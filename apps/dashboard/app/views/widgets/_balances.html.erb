<div class="h2 text-center"><%= t('dashboard.project_balances') %></div>

<ul class="list-group">
  <%- @my_balances.sort_by { |b| b.value }.each do |balance| -%>
    <li class="list-group-item">
      <b><%= balance.project %></b>: <%= balance %>
    </li>
  <%- end -%>
  <%- if @my_balances.empty? -%>
    <li class="list-group-item text-center"><%= t('dashboard.balance_no_warnings', threshold: Configuration.balance_threshold.to_i) %></li>
  <%- end -%>
</ul>
