<%= turbo_frame_tag(:possible_imports) do %>
<% unless @projects.empty? %>
  <div class='card mx-4 mb-2'>
    <div class='card-body'>
      <strong>
        <%= label :directory, I18n.t('dashboard.jobs_select_directory_placeholder') %>
      </strong>
      <div class="d-flex flex-wrap justify-content-around">
        <% @projects.each do |project| %>
	        <div id="<%= project.id %>" class="">
            <%= button_to project_import_save_path, method: :post,
                  params: { project: { directory: project.directory } },
                  data: { turbo_frame: '_top' },
                  title: "import #{project.title}",
                  class: 'project-icon card border-2 border-primary rounded-4 shadow-sm p-3 m-1 text-center' do %>
              <div class="text-center d-flex justify-content-center">
                <strong>
                  <%= icon_tag(URI.parse(project.icon), classes: ['fa-2x']) %>
                  <div class="project-title mt-2 mb-0">
                    <%= project.title %>
                    <%= content_tag(:small, PosixFile.username_from_cache(project.directory.stat.uid), class:'text-muted d-block') %>
                  </div>
                </strong>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<% end %>
