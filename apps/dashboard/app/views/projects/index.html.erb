<%= javascript_include_tag('projects_index', nonce: true, type: 'module') %>

<div class='page-header text-center'>
  <h1>Project Manager</h1>
</div>

<div class="row mt-3">
  <div class="col-md-8 col-lg-9 order-2 order-md-1" role="region" aria-label="Project list">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3">
      <% @projects.each do |project| %>
        <div id="<%= project.id %>" class="col project-card">
          <%= link_to(project_path(project.id), class: "project-icon card h-100 border-2 border-primary rounded-4 shadow-sm text-center text-reset text-decoration-none #{project.mine? ? '' : 'shared'}", title: t('dashboard.jobs_project_open_label', name: project.title)) do %>
            <div class="card-body">
              <%= icon_tag(URI.parse(project.icon), classes: ['fa-3x']) %>
              <%= content_tag(:div, class: 'project-title fs-5 fw-bold text-truncate mt-3') do %>
                <%= project.title %>
                <small class="d-block fs-6 fw-normal text-muted">
                  <%= PosixFile.username_from_cache(project.directory.stat.uid) unless project.mine? %>
                </small>
              <% end %>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0 pb-3">
              <div class="row g-2">
                <div class="col">
                  <% if project.deletable? %>
                    <%= button_to t('dashboard.delete'), project_path(project.id), class: 'btn btn-danger w-100', method: 'delete',
                          form: { class: 'button_to' },
                          data: { confirm: I18n.t('dashboard.jobs_project_delete_project_confirmation') },
                          aria: { label: t('dashboard.jobs_project_delete_label', name: project.title) }
                    %>
                  <% else %>
                    <%= button_to t('dashboard.remove'), project_path(project.id), class: 'btn btn-warning w-100', method: 'delete',
                          form: { class: 'button_to' },
                          aria: { label: t('dashboard.jobs_project_remove_label', name: project.title) }
                    %>
                  <% end %>
                </div>
                <% if project.editable? %>
                <div class="col">
                  <%= button_to t('dashboard.edit'), edit_project_path(project.id), class: 'btn btn-info w-100', method: 'get',
                        aria: { label: t('dashboard.jobs_project_edit_label', name: project.title) }
                  %>
                </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-md-4 col-lg-3 order-1 order-md-2 mb-5">

      <div class="justify-content-center text-center">
        <%= link_to(new_project_path,
              title: I18n.t('dashboard.jobs_create_blank_project'),
              class: 'btn btn-primary w-100') do
        %>
          <div class="text-center d-flex align-items-center justify-content-between">
            <strong>
              <%= I18n.t('dashboard.jobs_create_blank_project') %>
            </strong>
              <%= icon_tag(URI.parse("fas://file-medical"), classes:['fa-lg']) %>
          </div>
        <% end %>
      </div>

      <% if @templates.size.positive? %>
        <div class="mt-3 justify-content-center text-center">
          <%= link_to(new_project_path({template: true}),
                title: I18n.t('dashboard.jobs_create_template_project'),
                class: 'btn btn-outline-primary w-100') do
          %>
            <div class="text-center d-flex align-items-center justify-content-between">
              <strong>
                <%= I18n.t('dashboard.jobs_create_template_project') %>
              </strong>
              <%= icon_tag(URI.parse("fas://copy"), classes:['fa-lg']) %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mt-3 justify-content-center text-center">
        <a class="btn btn-outline-primary w-100" data-bs-toggle="collapse" data-bs-target="#load-import-pane"
          title="<%= I18n.t('dashboard.jobs_import_shared_project')%>" href="#">

          <div class="text-center d-flex align-items-center justify-content-between">
            <strong>
              <%= I18n.t('dashboard.jobs_import_shared_project') %>
            </strong>
            <%= icon_tag(URI.parse("fas://file-import"), classes:['fa-lg']) %>
          </div>
        </a>
        <div id="load-import-pane" class="collapse">
          <%= render partial: 'import' %>
        </div>
      </div>

  </div>
</div>
