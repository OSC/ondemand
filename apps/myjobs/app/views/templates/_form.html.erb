<%= bootstrap_form_for(@template) do |f| %>
  <% if @template.errors.any? %>

    <script type="text/javascript">
      $( document ).ready(function() {
          let inputs = $(".has-error input");
          if(inputs.length > 0){
            inputs.first().focus();
          }
          else{
            $('#error_explanation').focus()
          }
      });
    </script>

    <div id="error_explanation">
      <h4><%= pluralize(@template.errors.count, "error") %> prohibited this template from being saved:</h4>
      <ul>
        <% @template.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>

  <% end %>

  <div class="panel panel-default">
    <div class="panel-body">
      <div class="field">
        <%= f.text_field :path, label: "Path (the template will be created by copying files from this source path)", :id => "path_field" %>
      </div>
      <div>
        <p class="small">&bull; If left blank, a default job script will be added to your new template.</p>
      </div>
    </div>
  </div>

  <div class="panel panel-default">
    <div class="panel-body">
      <div class="field">
        <%= f.text_field :name, :id => "name_field" %>
      </div>
      <div class="field">
        <%= f.select :host, OODClusters.map { |cluster| [ "#{cluster.title}", cluster.id ] }, { label: "Cluster:" }, { selected: @template.host, class: "selectpicker", id: "server picker", required: true } %>
      </div>
      <div class="field">
        <%= f.text_area :notes, :id => "notes_field" %>
      </div>
      <div class="actions">

        <%= f.hidden_field :script, { value: @template.script } %>

        <%= f.submit "Save", :id => "save_button" %>
        <%= link_to "Cancel", :new_workflow, :class => "btn btn-default" %>
      </div>
    </div>
  </div>
<% end %>


<ol id="joyride" style="display: none;" data-joyride>
  <li data-id="path_field" data-button="<%= t('jobcomposer.joyride.next') %>">
    <p>
      <%= t('jobcomposer.joyride.templates_form.path') %>
    </p>
  </li>
  <li data-id="name_field" data-button="<%= t('jobcomposer.joyride.next') %>">
    <p>
      <%= t('jobcomposer.joyride.templates_form.name') %>
    </p>
  </li>
  <li data-id="server_picker" data-button="<%= t('jobcomposer.joyride.next') %>">
    <p>
      <%= t('jobcomposer.joyride.templates_form.cluster') %>
    </p>
  </li>
  <li data-id="notes_field" data-button="<%= t('jobcomposer.joyride.next') %>">
    <p>
      <%= t('jobcomposer.joyride.templates_form.notes') %>
    </p>
  </li>
  <li data-id="save_button" data-button="<%= t('jobcomposer.joyride.next') %>">
    <p>
      <%= t('jobcomposer.joyride.templates_form.save') %>
    </p>
  </li>
</ol>
